def odd_finder(a,b,c,d,e,f,g,h,i,j):
    parameters = [a,b,c,d,e,f,g,h,i,j]
    positive_odd_count = 0
    for i in parameters:
        if (i % 2) != 0 and i > 0:
            positive_odd_count += 1
    return positive_odd_count
